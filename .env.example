# Agentic Workflow — environment template
# Copy to .env (development), .env_test, .env_uat, or .env_prod and fill in real values.
# NEVER commit a filled-in copy. All values below are placeholders.

# 环境设置 (development | test | uat | production)
FASTAPI_ENV=development

# CORS 允许的来源 (逗号分隔的允许列表, e.g. https://app.example.com,https://admin.example.com)
# 留空 = 禁止跨域访问 (fail closed)。设为 "*" 会允许任意来源但会禁用凭证 (credentials)。
# 出于安全考虑, 通配符 "*" 不能与凭证共用。
CORS_ALLOW_ORIGINS=

# 内存监控 (诊断工具, 默认关闭)。启用后会开后台线程、每个请求做内存快照并暴露诊断路由。
# 仅在排查内存问题时开启: MEMORY_MONITOR_ENABLED=true
MEMORY_MONITOR_ENABLED=false

## MySQL 数据库配置
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=workflow

# 连接池配置
POOL_SIZE=100
MAX_OVERFLOW=100
POOL_RECYCLE=600
POOL_PRE_PING=True
POOL_TIMEOUT=30

## Redis 配置
REDIS_ENABLED=True
REDIS_MODEL=cluster
REDIS_CLUSTERS=your-redis-host:6379
REDIS_PASSWORD=your-redis-password
REDIS_USERNAME=default
REDIS_DB=0
REDIS_POOL_SIZE=500
REDIS_POOL_TIMEOUT=10
REDIS_SOCKET_TIMEOUT=10
REDIS_CONNECT_TIMEOUT=10

# 缓存与分页
CACHE_DEFAULT_TIMEOUT=300
MESSAGES_PER_PAGE=25

## 内部服务地址 (replace with your own endpoints)
HOLOGRES_URL=http://your-hologres-host/api/sql
TIME_SVC_URL=http://your-time-service/parse-time
KNOWLEDGE_INDEXER_BASE_URL=http://your-indexer-host/api/v3/search
KNOWLEDGE_INDEXER_MULTI_URL=http://your-indexer-host/api/v3/search/multi_collection

# MCP Web Search 配置
MCP_REMOTE_URL=http://your-mcp-host
MCP_API_KEY=your-mcp-api-key
MCP_TIMEOUT=120
MCP_DEBUG=false

## Tavily 搜索
TAVILY_API_KEY=your-tavily-api-key

## 阿里云 OSS (对象存储)
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_ENDPOINT=https://oss-cn-region.aliyuncs.com
OSS_BUCKET_NAME=your-bucket

## LLM 凭证
OPENAI_KEY=your-openai-or-azure-key
OPENAI_ENDPOINT=https://your-azure-openai-endpoint/
DASHSCOPE_KEY=your-dashscope-key
DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百度千帆 (demo_chatflow 的 HTTP 请求节点使用)
QIANFAN_API_KEY=bce-v3/your-qianfan-api-key

## 向量 / 检索
HOLOGRES_VECTOR_URL=http://your-hologres-host/api/vector/sql
ES_URL=http://your-elasticsearch-host:9200
ES_USERNAME=elastic
ES_PASSWORD=your-es-password

## Langfuse 可观测性 (SDK 从环境变量隐式读取)
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_BASE_URL=https://your-langfuse-host
LANGFUSE_FLUSH_INTERVAL=2
LANGFUSE_FLUSH_AT=128
# LANGFUSE_SAMPLE_RATE=0.2
